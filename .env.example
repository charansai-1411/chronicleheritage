# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Comma-separated fallbacks; first that works is used
GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash
# Trained YOLO26l heritage-damage weights (best.pt)
YOLO_WEIGHTS=models/weights/yolo26l_heritage.pt
YOLO_IMGSZ=640
# "" = auto (GPU if available) | cpu | 0
YOLO_DEVICE=
# Default SQLite; e.g. postgresql+psycopg2://user:pass@localhost:5432/chronicle
# DATABASE_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WAYBACK_ZOOM=18
